{
	"name": "emotional-healing-companion",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --host --port 8080",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"test": "node --test scripts/*.test.mjs",
		"verify": "npm run typecheck && npm run build && npm run test",
		"fmt": "npm run prettier:svelte && npm run prettier",
		"prettier:svelte": "npx -p prettier@2 -- prettier --plugin-search-dir . --write .",
		"prettier": "npx -p prettier@2 -- prettier --write '**/*.{js,css,md,html,json}'"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^2.1.1",
		"@sveltejs/kit": "^1.20.4",
		"@tailwindcss/typography": "^0.5.10",
		"@types/bcryptjs": "^2.4.6",
		"@types/katex": "^0.16.7",
		"@types/node": "^25.9.1",
		"@types/uuid": "^10.0.0",
		"autoprefixer": "^10.4.16",
		"postcss": "^8.4.31",
		"prettier": "^2.8.0",
		"prettier-plugin-svelte": "^2.10.1",
		"svelte": "^4.0.5",
		"tailwindcss": "^3.3.3",
		"typescript": "^5.0.0",
		"vite": "^4.5.2"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/adapter-node": "^1.3.1",
		"@types/dompurify": "^3.0.5",
		"bcryptjs": "^3.0.3",
		"dompurify": "^3.4.5",
		"highlight.js": "^11.9.0",
		"idb": "^7.1.1",
		"jszip": "^3.10.1",
		"katex": "^0.16.9",
		"mammoth": "^1.12.0",
		"marked": "^9.1.0",
		"mysql2": "^3.13.0",
		"pdf-parse": "^2.4.5",
		"sherpa-onnx": "^1.13.2",
		"svelte-french-toast": "^1.2.0",
		"tippy.js": "^6.3.7",
		"uuid": "^9.0.1",
		"word-extractor": "^1.0.4",
		"xlsx": "^0.18.5"
	}
}
